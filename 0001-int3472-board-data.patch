Subject: [PATCH] platform/x86: int3472: Add board data for ThinkPad X1 Tablet Gen 3

The OV8858 rear sensor is not on I2C2 directly: it hangs off the TPS68470's
secondary I2C passthrough port. The VSIO regulator's enable bit IS S_I2C_CTL,
so VSIO must be always_on for the sensor to be reachable independent of probe
order. VIO supplies the sensor's DOVDD. GPIO 9 = reset, GPIO 7 = powerdown,
both active low -- matching Intel's iactrllogic64.sys and the Latitude 5285.

--- a/drivers/platform/x86/intel/int3472/tps68470_board_data.c
+++ b/drivers/platform/x86/intel/int3472/tps68470_board_data.c
@@ -287,6 +287,121 @@
 	},
 };
 
+/* Settings for Lenovo ThinkPad X1 Tablet Gen 3 */
+
+static struct regulator_consumer_supply int3477_core_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dvdd", "i2c-INT3477:00"),
+};
+
+static struct regulator_consumer_supply int3477_ana_consumer_supplies[] = {
+	REGULATOR_SUPPLY("avdd", "i2c-INT3477:00"),
+};
+
+static struct regulator_consumer_supply int3477_vcm_consumer_supplies[] = {
+	REGULATOR_SUPPLY("vdd", "i2c-INT3477:00-VCM"),
+};
+
+static struct regulator_consumer_supply int3477_vio_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dovdd", "i2c-INT3477:00"),
+};
+
+static struct regulator_consumer_supply int3477_vsio_consumer_supplies[] = {
+	REGULATOR_SUPPLY("vsio", "i2c-INT3477:00"),
+};
+
+static const struct regulator_init_data thinkpad_x1t3_tps68470_core_reg_init_data = {
+	.constraints = {
+		.min_uV = 1200000,
+		.max_uV = 1200000,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_core_consumer_supplies),
+	.consumer_supplies = int3477_core_consumer_supplies,
+};
+
+static const struct regulator_init_data thinkpad_x1t3_tps68470_ana_reg_init_data = {
+	.constraints = {
+		.min_uV = 2815200,
+		.max_uV = 2815200,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_ana_consumer_supplies),
+	.consumer_supplies = int3477_ana_consumer_supplies,
+};
+
+static const struct regulator_init_data thinkpad_x1t3_tps68470_vcm_reg_init_data = {
+	.constraints = {
+		.min_uV = 2815200,
+		.max_uV = 2815200,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_vcm_consumer_supplies),
+	.consumer_supplies = int3477_vcm_consumer_supplies,
+};
+
+/* VIO supplies the sensor's DOVDD; keep it always-on at the same voltage as VSIO */
+static const struct regulator_init_data thinkpad_x1t3_tps68470_vio_reg_init_data = {
+	.constraints = {
+		.min_uV = 1800600,
+		.max_uV = 1800600,
+		.apply_uV = true,
+		.always_on = true,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_vio_consumer_supplies),
+	.consumer_supplies = int3477_vio_consumer_supplies,
+};
+
+/*
+ * The OV8858 does not sit on I2C2 directly: it hangs off the TPS68470's
+ * secondary I2C passthrough port. The VSIO regulator's enable bit *is*
+ * S_I2C_CTL (see TPS68470_REGULATOR(VSIO, ...) in tps68470-regulator.c), so
+ * enabling VSIO is what opens that passthrough. Mark it always_on so the
+ * passthrough is up from boot and the sensor is reachable regardless of the
+ * order in which tps68470-regulator, ipu-bridge and ov8858 happen to probe.
+ */
+static const struct regulator_init_data thinkpad_x1t3_tps68470_vsio_reg_init_data = {
+	.constraints = {
+		.min_uV = 1800600,
+		.max_uV = 1800600,
+		.apply_uV = true,
+		.always_on = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_vsio_consumer_supplies),
+	.consumer_supplies = int3477_vsio_consumer_supplies,
+};
+
+static const struct tps68470_regulator_platform_data thinkpad_x1t3_tps68470_pdata = {
+	.reg_init_data = {
+		[TPS68470_CORE] = &thinkpad_x1t3_tps68470_core_reg_init_data,
+		[TPS68470_ANA]  = &thinkpad_x1t3_tps68470_ana_reg_init_data,
+		[TPS68470_VCM]  = &thinkpad_x1t3_tps68470_vcm_reg_init_data,
+		[TPS68470_VIO]  = &thinkpad_x1t3_tps68470_vio_reg_init_data,
+		[TPS68470_VSIO] = &thinkpad_x1t3_tps68470_vsio_reg_init_data,
+	},
+};
+
+static struct gpiod_lookup_table thinkpad_x1t3_int3477_gpios = {
+	.dev_id = "i2c-INT3477:00",
+	.table = {
+		GPIO_LOOKUP("tps68470-gpio", 9, "reset", GPIO_ACTIVE_LOW),
+		GPIO_LOOKUP("tps68470-gpio", 7, "powerdown", GPIO_ACTIVE_LOW),
+		{ }
+	}
+};
+
+static const struct int3472_tps68470_board_data thinkpad_x1t3_tps68470_board_data = {
+	.dev_name = "i2c-INT3472:05",
+	.tps68470_regulator_pdata = &thinkpad_x1t3_tps68470_pdata,
+	.n_gpiod_lookups = 1,
+	.tps68470_gpio_lookup_tables = {
+		&thinkpad_x1t3_int3477_gpios,
+	},
+};
+
 static const struct dmi_system_id int3472_tps68470_board_data_table[] = {
 	{
 		.matches = {
@@ -316,6 +431,13 @@
 		},
 		.driver_data = (void *)&dell_7212_tps68470_board_data,
 	},
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_VERSION, "ThinkPad X1 Tablet Gen 3"),
+		},
+		.driver_data = (void *)&thinkpad_x1t3_tps68470_board_data,
+	},
 	{ }
 };
 
