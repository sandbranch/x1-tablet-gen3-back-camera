Subject: [PATCH] media: i2c: ov8858: Add ACPI match for INT3477 and vsio supply

Mirrors upstream's 'media: ov8858: add ACPI device ID INT3477 and vsio power
supply' (Thierry Chatard, 2026-03-24). The TPS68470 VSIO regulator controls
S_I2C_CTL (0x43), which gates I2C passthrough to the sensor, so the driver
must request and hold it. Supply order: avdd, dvdd, dovdd, vsio.

Signed-off-by: David Sandquist <sandquist@gmail.com>

--- a/drivers/media/i2c/ov8858.c
+++ b/drivers/media/i2c/ov8858.c
@@ -79,8 +79,9 @@
 
 static const char * const ov8858_supply_names[] = {
 	"avdd",		/* Analog power */
-	"dovdd",	/* Digital I/O power */
 	"dvdd",		/* Digital core power */
+	"dovdd",	/* Digital I/O power */
+	"vsio",		/* TPS68470 S_I2C_CTL: I2C passthrough to the sensor */
 };
 
 struct regval {
@@ -1981,11 +1982,18 @@
 };
 MODULE_DEVICE_TABLE(of, ov8858_of_match);
 
+static const struct acpi_device_id ov8858_acpi_match[] = {
+	{ "INT3477" },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(acpi, ov8858_acpi_match);
+
 static struct i2c_driver ov8858_i2c_driver = {
 	.driver = {
 		.name = "ov8858",
 		.pm = &ov8858_pm_ops,
 		.of_match_table = ov8858_of_match,
+		.acpi_match_table = ov8858_acpi_match,
 	},
 	.probe		= ov8858_probe,
 	.remove		= ov8858_remove,
